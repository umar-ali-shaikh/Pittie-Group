# Copy this file to .env and fill in your real Hostinger mailbox details.
# Never commit the real .env file — it's already in .gitignore.

# Hostinger SMTP (Titan Mail). Check hPanel > Emails for the exact host if different.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your-mailbox-password

# Who receives contact form submissions (defaults to SMTP_USER if omitted)
MAIL_TO=contact@yourdomain.com

# The "From" address shown on the sent email (defaults to SMTP_USER if omitted)
MAIL_FROM=contact@yourdomain.com

# Local dev only — Vercel/Hostinger set this themselves
PORT=3000
